{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hooks/setup.sh",
            "description": "Ensure mpy-reviewer dependencies are installed"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "mpy-reviewer": {
      "type": "stdio",
      "command": "$CLAUDE_PROJECT_DIR/venv/bin/python",
      "args": ["$CLAUDE_PROJECT_DIR/mcp_server.py"],
      "env": {
        "PYTHONPATH": "$CLAUDE_PROJECT_DIR"
      }
    }
  }
}
